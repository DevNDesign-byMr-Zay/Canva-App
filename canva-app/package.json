{
  "name": "holoforge-canva-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "npx --yes @canva/cli@2.13.0 apps start",
    "start:preview": "npx --yes @canva/cli@2.13.0 apps start --preview",
    "build": "npx --yes @canva/cli@2.13.0 apps build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "npx --yes prettier@3.6.2 --check \"src/**/*.{ts,tsx}\"",
    "format": "npx --yes prettier@3.6.2 --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@canva/app-hooks": "^0.0.0-beta.4",
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.14.3",
    "@canva/design": "^2.13.0",
    "@canva/intents": "^2.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^7.1.11",
    "@canva/user": "^2.2.0"
  },
  "devDependencies": {
    "@canva/app-scripts": "^1.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/webpack-env": "^1.18.8",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
