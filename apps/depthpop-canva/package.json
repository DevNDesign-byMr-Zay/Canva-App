{
  "name": "depthpop-canva-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "npx --yes @canva/cli@2.13.0 apps start",
    "start:preview": "npx --yes @canva/cli@2.13.0 apps start --preview",
    "build": "npx --yes @canva/cli@2.13.0 apps build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@canva/app-hooks": "^0.0.0-beta.4",
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.14.3",
    "@canva/asset": "^2.3.1",
    "@canva/design": "^2.13.0",
    "@canva/intents": "^2.7.0",
    "@canva/user": "^2.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^7.1.11",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@canva/app-scripts": "^1.1.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/webpack-env": "^1.18.8",
    "eslint": "10.13.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "5.0.3"
  },
  "description": "DepthPop standalone Canva Design Editor app for authenticated depth-aware object-scene editing, animation, and production export.",
  "keywords": [
    "canva-app",
    "design-editor",
    "depthpop",
    "react-three-fiber",
    "threejs",
    "fastapi",
    "depth-estimation",
    "image-segmentation"
  ],
  "overrides": {
    "uuid": "11.1.1"
  }
}
