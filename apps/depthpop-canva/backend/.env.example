# Public Canva app identity and browser origin
# Production origin is also derived as https://app-<lowercase-app-id>.canva-apps.com.
CANVA_APP_ID=
CANVA_APP_ORIGIN=
# Optional comma-separated local development origins only.
DEPTHPOP_DEV_ORIGINS=http://localhost:8080

# Required server-side provider secret. Never expose FAL_KEY to the Canva bundle.
FAL_KEY=

# Provider selection. In production, "auto" requires FAL_KEY and never falls
# back to mock providers.
SEGMENTATION_PROVIDER=auto
DEPTH_PROVIDER=auto
INPAINT_PROVIDER=auto

# Optional production controls
DEPTHPOP_ALLOW_BBOX_FALLBACK=false
DEPTHPOP_INPAINT_MODEL=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
DEPTHPOP_INPAINT_PROMPT=clean natural background continuation matching the surrounding image; remove the masked foreground object; preserve scene lighting, texture, perspective, and style; no new text, logos, people, or products

# Environment ("production", "test", or local/dev)
ENVIRONMENT=production

# Persistence. Use sqlite for a restart-safe production deployment; memory is
# intended for isolated tests and explicit local development.
DEPTHPOP_REPOSITORY_BACKEND=sqlite
DEPTHPOP_DATABASE_PATH=/data/depthpop/depthpop.sqlite3
DEPTHPOP_ASSET_ROOT=/data/depthpop/assets

# Bounded repository capacity & TTL settings
DEPTHPOP_JOB_TTL_SECONDS=3600
DEPTHPOP_SCENE_TTL_SECONDS=3600
DEPTHPOP_SCENE_ASSET_TTL_SECONDS=3600
DEPTHPOP_MAX_JOBS=100
DEPTHPOP_MAX_SCENES=50
DEPTHPOP_MAX_SCENE_ASSETS=500

# Public HTTPS origin returned in protected scene-asset URLs.
# It should be the same backend origin configured in the Canva app.
# Example: https://depthpop.example.com
PUBLIC_BASE_URL=

# Runtime
PORT=8081
DEPTHPOP_MAX_CONCURRENCY=3
