# Public Canva app identity and browser origin
CANVA_APP_ID=
CANVA_APP_ORIGIN=

# Required server-side provider secret. Never expose this to the Canva frontend.
FAL_KEY=

# Public HTTPS origin Canva can use to fetch the generated image.
# Example: https://depthpop.example.com
PUBLIC_BASE_URL=

# Runtime
PORT=8081
DEPTHPOP_MAX_CONCURRENCY=3
