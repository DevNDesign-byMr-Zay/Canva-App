# Public Canva app identity and browser origin
CANVA_APP_ID=
CANVA_APP_ORIGIN=

# Required server-side provider secret (Florence-2 + SAM-3 + Depth Anything v2). Never expose to Canva bundle.
FAL_KEY=

# Provider selection ("fal", "mock"). Mocks allowed only when ENVIRONMENT=test or provider set to "mock".
DEPTH_PROVIDER=fal
SEGMENTATION_PROVIDER=fal
INPAINT_PROVIDER=mock

# Environment ("production", "test")
ENVIRONMENT=production

# Bounded repository capacity & TTL settings
DEPTHPOP_JOB_TTL_SECONDS=3600
DEPTHPOP_SCENE_TTL_SECONDS=3600
DEPTHPOP_MAX_JOBS=100
DEPTHPOP_MAX_SCENES=50

# Public HTTPS origin Canva can use to fetch generated media assets.
# Example: https://depthpop.example.com
PUBLIC_BASE_URL=

# Runtime
PORT=8081
DEPTHPOP_MAX_CONCURRENCY=3
