{
  "name": "holoforge-canva-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "npx --yes @canva/cli@2.13.0 apps start",
    "start:preview": "npx --yes @canva/cli@2.13.0 apps start --preview",
    "build": "npx --yes @canva/cli@2.13.0 apps build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.14.3",
    "@canva/asset": "^2.3.1",
    "@canva/design": "^2.13.0",
    "@canva/intents": "^2.7.0",
    "@canva/user": "^2.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^12.1.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@canva/app-scripts": "^1.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/webpack-env": "^1.18.8",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.0"
  },
  "description": "HoloForge standalone Canva Design Editor app for real-time 3D holographic authoring with authenticated Blender/FFmpeg rendering.",
  "keywords": [
    "canva-app",
    "design-editor",
    "holoforge",
    "react-three-fiber",
    "threejs",
    "blender",
    "ffmpeg",
    "3d-authoring"
  ],
  "overrides": {
    "uuid": "11.1.1",
    "deepmerge": "npm:@stackline/deepmerge@1.1.0"
  }
}
