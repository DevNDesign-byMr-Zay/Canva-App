# Archive verification and materialization remain credential-free.
# The trusted review-context backend requires only deployment configuration.
# Never commit real secrets, tokens, or private identifiers.

CANVA_APP_ID=
CANVA_APP_ORIGIN=
REVIEW_CONTEXT_SOURCE_URL=
PORT=8080

# CI/release metadata supplied automatically by GitHub Actions.
# These names are included for complete environment discovery and are not local secrets.
GITHUB_SHA=
RELEASE_TAG=

# Full-stack configuration reference: services have INDEPENDENT environments.
# Copy apps/depthpop-canva/backend/.env.example to the DepthPop backend and
# apps/holoforge-canva/backend/.env.example to the HoloForge backend.
# Shared names (CANVA_APP_ID, CANVA_APP_ORIGIN, PUBLIC_BASE_URL, PORT,
# ENVIRONMENT) are per-service, not a single set of values for both apps.
# The Canva frontend host is configured in each app's .env.template.

# ---- DepthPop backend configuration (reference only) ----
# Comma-separated, explicitly allowed local development origins; production origins use Canva identity.
DEPTHPOP_DEV_ORIGINS=http://localhost:8080
# Private fal.ai provider credential; inject into DepthPop server only, never into a Canva bundle.
FAL_KEY=
# DepthPop object-segmentation backend; auto uses the configured production provider.
SEGMENTATION_PROVIDER=auto
# DepthPop depth-estimation backend; auto uses the configured production provider.
DEPTH_PROVIDER=auto
# DepthPop inpainting backend; auto selects mask-guided object removal.
INPAINT_PROVIDER=auto
# Allow degraded bounding-box extraction in development; must be false for production.
DEPTHPOP_ALLOW_BBOX_FALLBACK=false
# Legacy diffusion compatibility field; current production mask-removal provider uses its own fixed model contract.
DEPTHPOP_INPAINT_MODEL=
# Legacy diffusion prompt; mask-guided object-removal endpoint does not consume this field.
DEPTHPOP_INPAINT_PROMPT=
# Service runtime mode; use development or test for local workflows, production only for a configured deployment.
ENVIRONMENT=production
# DepthPop persistence backend; use sqlite for production durability.
DEPTHPOP_REPOSITORY_BACKEND=sqlite
# Durable DepthPop SQLite path, writable within persistent /data/depthpop.
DEPTHPOP_DATABASE_PATH=/data/depthpop/depthpop.sqlite3
# Persistent DepthPop scene assets directory.
DEPTHPOP_ASSET_ROOT=/data/depthpop/assets
# DepthPop retention duration in seconds; tune to workload and storage policy.
DEPTHPOP_JOB_TTL_SECONDS=3600
# DepthPop retention duration in seconds; tune to workload and storage policy.
DEPTHPOP_SCENE_TTL_SECONDS=3600
# DepthPop retention duration in seconds; tune to workload and storage policy.
DEPTHPOP_SCENE_ASSET_TTL_SECONDS=3600
# DepthPop bounded capacity limit; tune conservatively for production.
DEPTHPOP_MAX_JOBS=100
# DepthPop bounded capacity limit; tune conservatively for production.
DEPTHPOP_MAX_SCENES=50
# DepthPop bounded capacity limit; tune conservatively for production.
DEPTHPOP_MAX_SCENE_ASSETS=500
# Persistent DepthPop export artifacts directory.
DEPTHPOP_ARTIFACT_ROOT=/data/depthpop/artifacts
# DepthPop retention duration in seconds; tune to workload and storage policy.
DEPTHPOP_EXPORT_JOB_TTL_SECONDS=3600
# DepthPop retention duration in seconds; tune to workload and storage policy.
DEPTHPOP_EXPORT_ARTIFACT_TTL_SECONDS=86400
# DepthPop bounded capacity limit; tune conservatively for production.
DEPTHPOP_MAX_EXPORT_JOBS=128
# DepthPop bounded capacity limit; tune conservatively for production.
DEPTHPOP_MAX_EXPORT_ARTIFACTS=64
# Maximum simultaneous DepthPop export jobs.
DEPTHPOP_MAX_EXPORT_CONCURRENCY=2
# Maximum image pixels per export request to bound memory/cost.
DEPTHPOP_MAX_EXPORT_PIXELS=16777216
# Maximum export frames to bound render work.
DEPTHPOP_MAX_EXPORT_FRAMES=3600
# Maximum export duration in milliseconds.
DEPTHPOP_MAX_EXPORT_DURATION_MS=120000
# Maximum export artifact size in bytes.
DEPTHPOP_MAX_EXPORT_ARTIFACT_BYTES=536870912
# Public HTTPS URL of each service; configure independently per backend environment.
PUBLIC_BASE_URL=
# DepthPop bounded capacity limit; tune conservatively for production.
DEPTHPOP_MAX_CONCURRENCY=3

# ---- HoloForge backend configuration (reference only) ----
# Absolute Blender executable path inside the HoloForge rendering container or host.
BLENDER_BIN=
# Required Blender version for HoloForge render validation.
HOLOFORGE_BLENDER_VERSION=4.5.14
# Maximum HoloForge Blender render time in seconds.
HOLOFORGE_RENDER_TIMEOUT_SECONDS=600
# HoloForge bounded capacity limit; tune conservatively for production.
HOLOFORGE_MAX_CONCURRENCY=2
# HoloForge bounded capacity limit; tune conservatively for production.
HOLOFORGE_MAX_JOBS=256
# HoloForge bounded capacity limit; tune conservatively for production.
HOLOFORGE_MAX_ARTIFACTS=128
# HoloForge retention duration in seconds; tune to workload and storage policy.
HOLOFORGE_JOB_TTL_SECONDS=3600
# HoloForge retention duration in seconds; tune to workload and storage policy.
HOLOFORGE_ARTIFACT_TTL_SECONDS=86400
# Persistent HoloForge export artifacts directory.
HOLOFORGE_ARTIFACT_ROOT=/data/holoforge/artifacts
# HoloForge persistence backend; use sqlite for production durability.
HOLOFORGE_REPOSITORY_BACKEND=sqlite
# Durable HoloForge SQLite path, writable within persistent /data/holoforge.
HOLOFORGE_DATABASE_PATH=/data/holoforge/holoforge.sqlite3
# Deploy validator: independent DepthPop Canva app identity alias.
DEPTHPOP_CANVA_APP_ID=
# Deploy validator: independent DepthPop Canva origin alias.
DEPTHPOP_CANVA_APP_ORIGIN=
# Deploy validator: independent DepthPop HTTPS backend alias.
DEPTHPOP_PUBLIC_BASE_URL=
# Deploy validator: DepthPop service runtime-mode alias.
DEPTHPOP_ENVIRONMENT=
# Deploy validator: independent HoloForge Canva app identity alias.
HOLOFORGE_CANVA_APP_ID=
# Deploy validator: independent HoloForge Canva origin alias.
HOLOFORGE_CANVA_APP_ORIGIN=
# Deploy validator: independent HoloForge HTTPS renderer alias.
HOLOFORGE_PUBLIC_BASE_URL=
# Deploy validator: HoloForge runtime-mode alias.
HOLOFORGE_ENVIRONMENT=
# Opt-in to non-standard absolute persistence paths in deployment validation.
DEPLOYMENT_ALLOW_CUSTOM_PERSISTENCE_PATHS=
# Canva CLI app-side backend host; configure in each application's .env file, not in browser source.
CANVA_BACKEND_HOST=
# Enables additional deployment-check diagnostics; keep disabled by default.
DEBUG_DEPLOYMENT_CHECK=false
