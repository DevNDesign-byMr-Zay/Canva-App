{
  "name": "canva-depth-archive-tooling",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "description": "Canva Design Editor application/tooling for authenticated archive verification, maintained runtime adapters, and trusted Design Editor integration.",
  "keywords": [
    "canva-app",
    "design-editor",
    "developer-tooling",
    "runtime-adapters",
    "application-verification"
  ],
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 tests/js/*.test.mjs",
    "test:js": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 tests/js/*.test.mjs",
    "demo:energy-runtime": "node scripts/energy-runtime-demo.mjs",
    "check": "npm run verify:release && npm run verify:syntax && npm run verify:standalone-apps && npm test",
    "backend:start": "node backend/review-context-service.mjs",
    "app:verify": "npm --prefix canva-app ci --ignore-scripts && npm --prefix canva-app audit --omit=dev --audit-level=moderate && npm --prefix canva-app run typecheck && npm --prefix canva-app run test:coverage && npm --prefix canva-app run build",
    "verify:release": "node scripts/verify-release-readiness.mjs",
    "verify:syntax": "node scripts/verify-maintained-js-syntax.mjs",
    "lint": "npm run verify:syntax",
    "format:check": "npm --prefix canva-app run format:check",
    "package:canva-ui": "node scripts/assemble-canva-ui-package.mjs",
    "verify:standalone-apps": "node scripts/verify-standalone-canva-apps.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/holographic-scene-adapter.mjs",
    "./holographic-scene": "./src/holographic-scene-adapter.mjs",
    "./holographic-scene-fingerprint": "./src/holographic-scene-fingerprint.mjs",
    "./holographic-scene-binding": "./src/holographic-scene-binding.mjs",
    "./holographic-presentation-record": "./src/holographic-presentation-record.mjs",
    "./holographic-operator-view": "./src/holographic-operator-view.mjs",
    "./ai-holographic-scene": "./src/ai-holographic-scene.mjs",
    "./holographic-roundtrip": "./src/holographic-scene-roundtrip.mjs",
    "./holographic-roundtrip-view": "./src/holographic-roundtrip-view.mjs",
    "./holographic-interaction-map": "./src/holographic-interaction-map.mjs"
  },
  "dependencies": {
    "@canva/app-middleware": "0.0.0-beta.8"
  }
}
