{
  "name": "canva-depth-archive-tooling",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Canva-oriented application tooling for authenticated archive verification, maintained runtime adapters, and trusted Design Editor integration.",
  "keywords": [
    "canva-app",
    "design-editor",
    "developer-tooling",
    "runtime-adapters",
    "application-verification"
  ],
  "scripts": {
    "test": "node --experimental-test-coverage --test tests/js/*.test.mjs",
    "test:js": "node --experimental-test-coverage --test tests/js/*.test.mjs",
    "demo:energy-runtime": "node scripts/energy-runtime-demo.mjs",
    "check": "npm run verify:release && npm test",
    "backend:start": "node backend/review-context-service.mjs",
    "app:verify": "npm --prefix canva-app ci --ignore-scripts && npm --prefix canva-app audit --omit=dev --audit-level=moderate && npm --prefix canva-app run typecheck && npm --prefix canva-app test && npm --prefix canva-app run build",
    "verify:release": "node scripts/verify-release-readiness.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/holographic-scene-adapter.mjs",
    "./holographic-scene": "./src/holographic-scene-adapter.mjs",
    "./holographic-scene-fingerprint": "./src/holographic-scene-fingerprint.mjs",
    "./holographic-scene-binding": "./src/holographic-scene-binding.mjs",
    "./holographic-presentation-record": "./src/holographic-presentation-record.mjs",
    "./holographic-operator-view": "./src/holographic-operator-view.mjs",
    "./ai-holographic-scene": "./src/ai-holographic-scene.mjs",
    "./holographic-roundtrip": "./src/holographic-scene-roundtrip.mjs",
    "./holographic-roundtrip-view": "./src/holographic-roundtrip-view.mjs",
    "./holographic-interaction-map": "./src/holographic-interaction-map.mjs"
  },
  "dependencies": {
    "@canva/app-middleware": "0.0.0-beta.8"
  }
}
